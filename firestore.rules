rules_version = '2';

// Srya — Firestore Security Rules
// Principle: a signed-in user can read and write ONLY their own data.
// Nothing under another user's path is ever readable or writable.

service cloud.firestore {
  match /databases/{database}/documents {

    // Everything Srya stores lives under users/{uid}/...
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
